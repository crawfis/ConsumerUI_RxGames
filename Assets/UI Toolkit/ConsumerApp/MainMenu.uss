#main-container {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100%;
    background-image: resource('RepreatingBackground');
    -unity-background-image-tint-color: rgb(46, 46, 53);
}

#dropdown-container {
    display: flex;
    flex-direction: row;
    flex: 1 1 auto;
    justify-content: space-between;
    align-items: center;
    width: 40%;
    height: auto;
    margin-bottom: 20px;
    max-height: 10%;
}

#locale-selection-dropdown {
    font-size: 32px;
    min-width: 25%;
    border-width: 10px;
    border-radius: 60px;
    flex: 1 1 0;
    align-self: flex-end;
    height: auto;
}

#button-container {
    display: flex;
    flex-direction: column;
    width: 70%;
    justify-content: center;
    align-items: stretch;
    font-size: 48px;
    -unity-text-auto-size: bestFit 48px 96px;
    padding-left: 100px;
    padding-right: 100px;
}

.unity-button {
    -unity-font-style: bold;
    font-size: 100%;
    flex: 1 1 0;
    -unity-text-align: middle-center;
    -unity-text-auto-size: bestFit 180px 640px;
    padding: 10px;
    margin: 15px;
    border-radius: 20px;
    border-width: 6px;
    border-color: rgb(51, 51, 51);
    background-color: rgb(30, 144, 255);
    color: white;
}

.unity-button:disabled {
    background-color: rgb(204, 204, 204);
    color: rgb(102, 102, 102);
    border-color: rgb(170, 170, 170);
}

.unity-button.primary {
    background-color: rgb(30, 144, 255);
    color: white;
}

.unity-button.secondary {
    background-color: rgb(240, 240, 240);
    color: rgb(34, 34, 34);
}

.unity-button:hover {
    background-color: rgb(24, 123, 205);
    color: yellow;
    scale: 1.25;
}

.button:active {
    background-color: rgb(20, 90, 150);
}

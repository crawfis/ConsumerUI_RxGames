/* Main container to center content */
#main-container {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100%;
}
#dropdown-container {
    display: flex;
    flex-direction: row;
    flex: 1 1 auto;
    justify-content: space-between;
    align-items: center;
    width: 40%;
    height: auto;
    margin-bottom: 20px;
    max-height: 10%;
}
/* Locale selection dropdown */
#locale-selection-dropdown {
    font-size: 32px;
    min-width: 25%;
    border-width: 10px;
    border-radius: 60px;
    flex: 1 1 0;
    align-self: flex-end;
    height: auto;
}

/* Button container for stacking buttons */
#button-container {
    display: flex;
    flex-direction: column;
    width: 70%;
    justify-content: center;
    align-items: stretch;
    font-size: 48px;
    -unity-text-auto-size: bestFit 48px 96px;
    padding-left: 100px;
    padding-right: 100px;
}

/* Base button style */
.unity-button {
    -unity-font-style: bold;
    font-size: 100%;
    flex: 1 1 0;
    /*align-self: stretch;*/
    -unity-text-align: middle-center;
    -unity-text-auto-size: bestFit 180px 640px;
    padding: 10px;
    margin: 15px;
    border-radius: 20px;
    border-width: 6px;
    border-color: #333;
    background-color: #1e90ff; /* default blue */
    color: white;
}

/* Hover effect for buttons 
.unity-button:hover {
    background-color: #005A9E;
}*/

/* Disabled button style */
.unity-button:disabled {
    background-color: #CCCCCC;
    color: #666666;
    border-color: #AAAAAA;
}
/* Variants */
.unity-button.primary {
    background-color: #1e90ff;
    color: white;
}

.unity-button.secondary {
    background-color: #f0f0f0;
    color: #222;
}

/* Hover/active (if runtime theme supports pseudo-classes) */
.unity-button:hover {
    background-color: #187bcd;
    color: yellow;
    scale: 1.25;
}

.button:active {
    background-color: #145a96;
}